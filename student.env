# =============================================================================
#  student.env - THÔNG TIN SINH VIÊN & THÔNG SỐ TRIỂN KHAI  (ĐỀ 004)
# -----------------------------------------------------------------------------
#  - Sinh viên BẮT BUỘC điền đầy đủ các giá trị trống "" bên dưới.
#  - Pipeline CI/CD đọc file này: thiếu thông tin -> pipeline FAIL, không deploy.
#  - Quy tắc: KEY="giá trị", không có dấu cách quanh dấu "=".
#    Mỗi dòng 1 biến, ghi chú phải nằm trên dòng riêng (bắt đầu bằng #).
# =============================================================================

# ---------- 1. Thông tin sinh viên ----------
STUDENT_NAME=""
STUDENT_ID=""
STUDENT_CLASS=""
STUDENT_EMAIL=""
GITHUB_USERNAME=""

# ---------- 2. Thông số triển khai trên server chung ----------
# Mã đề (KHÔNG sửa)
EXAM_CODE="004"
# Cổng cá nhân trên server chung: từ 8080 trở lên, KHÔNG trùng với bạn khác
APP_PORT=""
# Tên project Docker Compose: <tên-viết-tắt>-de004, viết thường, ví dụ: nguyenvana-de004
COMPOSE_PROJECT_NAME=""

# ---------- 3. Cơ sở dữ liệu MySQL ----------
# Tên database (KHÔNG sửa)
MYSQL_DATABASE="ptit_inventory_db"
# Tài khoản ứng dụng và mật khẩu: tự đặt, không để trống
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
